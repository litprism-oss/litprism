# .env.example
# LLM provider — pick one to start
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Or Gemini (Google AI Studio key):
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# LLM_MODEL=gemini-3.5-flash-lite
# Define each variable once: dotenv loaders keep the FIRST duplicate, so an old
# LLM_PROVIDER=azure higher up silently wins over a LLM_PROVIDER=gemini below it.

# Or Azure:
# LLM_PROVIDER=azure
# AZURE_API_KEY=
# AZURE_API_BASE=https://myresource.openai.azure.com
# AZURE_API_VERSION=2024-02-01
# AZURE_DEPLOYMENT_NAME=gpt-4o

# Or Ollama (no key needed, must have Ollama running locally):
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1

# PubMed (optional — without it you get 3 req/s)
PUBMED_API_KEY=

# Semantic Scholar (optional — without it rate limit is lower)
SEMANTIC_SCHOLAR_API_KEY=

# App database (SQLite default, no config needed for local dev)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/litprism
# Supabase: paste the connection string as-is (postgresql:// is rewritten to asyncpg).
# Use the transaction pooler (:6543) for the running app; for `alembic upgrade head`
# use the direct (:5432) or session-pooler string.

# Browser origins allowed by CORS, comma-separated (default * = any origin)
# CORS_ORIGINS=https://litprism.vercel.app

# App storage
UPLOAD_DIR=~/.litprism/uploads

# Celery (Redis must be running)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Auth (Supabase). Local dev: leave AUTH_DISABLED=true and skip the rest.
AUTH_DISABLED=true
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_JWT_SECRET=          # only for legacy HS256 projects; empty = verify via JWKS
# ADMIN_EMAILS=you@example.com  # comma-separated, unlimited credits
# BOOTSTRAP_OWNER_EMAIL=you@example.com  # claims existing ownerless projects on first login
