# Backend API the browser talks to. Set these in Vercel > Project > Settings > Environment Variables.
# Local dev falls back to http://localhost:8000 / ws://localhost:8000 when unset.
VITE_API_URL=https://your-backend.fly.dev
VITE_WS_URL=wss://your-backend.fly.dev

# Login (Supabase Auth). Leave both unset for local development with AUTH_DISABLED=true on the API.
# Project Settings > API: the project URL and the "anon" public key (safe to expose in the browser).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
